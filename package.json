{
  "name": "stillwater-diary",
  "productName": "Stillwater",
  "version": "0.2.3",
  "description": "A quiet, offline desktop diary with local SQLite storage.",
  "author": "Stillwater contributors",
  "license": "UNLICENSED",
  "private": true,
  "main": "desktop/main.cjs",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "start:web": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check server.mjs && node --check public/app.js && node --check public/math-symbols.js && node --check public/equations.js",
    "build:win": "electron-builder --win portable nsis --x64 --publish never",
    "build:unpacked": "electron-builder --win --x64 --dir --publish never",
    "test:editor": "electron tests/math-editor.cjs"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.stillwater.diary",
    "productName": "Stillwater",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "server.mjs",
      "desktop/**/*.cjs",
      "desktop/**/*.mjs",
      "public/index.html",
      "public/app.js",
      "public/equations.js",
      "public/vendor/katex/katex.min.js",
      "public/vendor/katex/katex.min.css",
      "public/vendor/katex/fonts/*.woff2",
      "public/vendor/katex/LICENSE",
      "public/vendor/katex/vendor-manifest.json",
      "THIRD_PARTY_NOTICES.txt",
      "public/math-symbols.js",
      "public/math-symbols.css",
      "public/styles.css",
      "public/extras.css",
      "public/icon.svg",
      "build/icon.png",
      "build/icon.ico",
      "!**/*.map",
      "!**/*.test.*",
      "!**/{data,diary,user-data,exports,backups,node_modules}/**",
      "!**/*.{sqlite,sqlite3,db,db3}",
      "!**/*.{sqlite,sqlite3,db,db3}-*",
      "!**/*backup*.json",
      "!**/*.log*",
      "!**/.env*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Stillwater-${version}-Windows-x64.exe"
    },
    "nsis": {
      "artifactName": "Stillwater-${version}-Setup-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
