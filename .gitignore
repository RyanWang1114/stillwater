# Track source deliberately. New root-level files stay private until reviewed.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.github/**
!/README.md
!/README.txt
!/THIRD_PARTY_NOTICES.txt
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/.npmrc
!/.node-version
!/server.mjs
!/launch.ps1
!/Start Stillwater.cmd
!/Start Stillwater.vbs
!/public/
!/public/**
!/desktop/
!/desktop/**
!/tests/
!/tests/**
!/scripts/
!/scripts/**
!/docs/
!/docs/**
!/assets/
!/assets/**
!/build/
!/build/**

# Personal diary data, exports and backups must never enter source control.
**/data/
**/diary/
**/user-data/
**/userdata/
**/exports/
**/backups/
**/backup/
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.db3
*.db3-*
*backup*.json
*Backup*.json
*.bak
*.backup

# Dependencies, generated releases, temporary work and logs.
**/node_modules/
**/.pnpm-store/
**/release/
**/dist/
**/out/
**/coverage/
**/work/
**/tmp/
**/temp/
*.exe
*.msi
*.dll
*.asar
*.zip
*.7z
*.tar
*.gz
*.blockmap
*.log
*.log.*
*.dmp
*.tmp
*.tsbuildinfo

# Machine-specific configuration and signing material.
**/.env
**/.env.*
!**/.env.example
*.pfx
*.p12
*.pem
*.key
.DS_Store
Thumbs.db
Desktop.ini
